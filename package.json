  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "node -e \"require('os').platform() === 'win32' ? require('child_process').spawnSync('cmd', ['/c', 'set NODE_ENV=development && nest start --watch'], { stdio: 'inherit' }) : require('child_process').spawnSync('sh', ['-c', 'NODE_ENV=development nest start --watch'], { stdio: 'inherit' })\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "build:full": "npm run frontend:build && npm run build",
    "frontend:preview": "cd frontend && npm run preview",
    "vm:install-scanners": "bash scripts/install-vm-scanners.sh",
    "vm:check-scanners": "bash scripts/check-vm-scanners.sh",
    "vm:scan": "bash scripts/vm-scan.sh"
  },
