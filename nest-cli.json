{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [     
      {
        "include": "../email-templates/**/*",
        "outDir": "./dist/email-templates"
      },
      {
        "include": "../public/**/*",
        "outDir": "./dist/public"
      }
    ]
  }
}
