# Generic integration worker
INTEGRATION_SYNC_BATCH_SIZE=25
INTEGRATION_SYNC_MAX_ATTEMPTS=8
INTEGRATION_SYNC_RETRY_BASE_SECONDS=30

# HighLevel defaults. A client-system record can override non-secret values.
HIGHLEVEL_API_BASE_URL=https://services.leadconnectorhq.com
HIGHLEVEL_API_VERSION=2021-07-28
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_PRIVATE_TOKEN=

# Example secrets referenced by client-system.secretReferences
CLIENT_CDP_BEARER_TOKEN=
CLIENT_WEBHOOK_HMAC_SECRET=
CLIENT_DWH_API_KEY=
