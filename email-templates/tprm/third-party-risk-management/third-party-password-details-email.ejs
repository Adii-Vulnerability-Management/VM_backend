<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Third Party Assessment Password</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f7fa;
      margin: 0;
      padding: 0;
      color: #333333;
      line-height: 1.6;
    }

    .email-container {
      max-width: 600px;
      margin: 30px auto;
      background-color: #ffffff;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
      overflow: hidden;
    }

    .email-body {
      padding: 24px 30px;
    }

    .email-body p {
      margin: 14px 0;
      font-size: 14px;
      color: #555555;
    }

    .email-body strong {
      color: #222222;
    }

    .subject-line {
      font-size: 15px;
      color: #084179;
      margin-bottom: 18px;
    }

    .credential-box {
      background-color: #f1f9ff;
      border-left: 4px solid #0073e6;
      padding: 14px 16px;
      margin: 20px 0;
      border-radius: 4px;
    }

    .credential-row {
      margin: 8px 0;
      font-size: 14px;
      color: #444444;
    }

    .password-value {
      display: inline-block;
      font-family: monospace;
      font-size: 15px;
      color: #111827;
      background-color: #ffffff;
      border: 1px solid #dbeafe;
      padding: 6px 10px;
      border-radius: 4px;
      margin-top: 4px;
    }

    .button-link {
      display: inline-block;
      padding: 10px 18px;
      background-color: #0073e6;
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 5px;
      font-size: 14px;
      margin: 15px 0;
    }

    .button-link:hover {
      background-color: #005bb5;
    }

    .security-note {
      background-color: #fff7ed;
      border-left: 4px solid #f97316;
      padding: 10px 12px;
      font-size: 13px;
      color: #7c2d12;
      margin-top: 18px;
      border-radius: 4px;
    }

    .email-footer {
      display: flex;
      align-items: center;
      padding: 20px;
      background-color: #f9f9f9;
    }

    .green-line {
      width: 4px;
      background-color: #00b050;
      align-self: stretch;
      margin-right: 15px;
    }

    .footer-content {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .company-logo img {
      max-width: 75px;
      height: auto;
      margin-right: 10px;
    }

    .details h2 {
      margin: 0;
      font-size: 16px;
      color: #084179;
    }

    .details p {
      margin: 3px 0;
      font-size: 13px;
      color: #555555;
    }

    .details a {
      color: #0073e6;
      text-decoration: none;
    }

    .details a:hover {
      text-decoration: underline;
    }

    .confidential-text {
      padding: 12px 20px 18px;
      background-color: #f9f9f9;
      text-align: center;
      font-size: 12px;
      color: #777777;
    }

    @media only screen and (max-width: 640px) {
      .email-container {
        margin: 15px;
      }

      .email-body {
        padding: 20px;
      }

      .email-footer {
        align-items: flex-start;
      }

      .footer-content {
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>
  <div class="email-container">

    <!-- Body Section -->
    <div class="email-body">
      <p>Dear <strong><%= leadResponderName || 'Third Party Responder' %></strong>,</p>

      <p class="subject-line">
        <strong>Subject:</strong> Assessment Portal Password
      </p>

      <p>
        We are providing access to the third-party assessment portal to complete the questionnaire. Please see the login details below:
      </p>

      <div class="credential-box">
        <p class="credential-row">
          <strong>Login ID:</strong><br />
          <%= loginId || '-' %>
        </p>

        <p class="credential-row">
          <strong>Password:</strong><br />
          <span class="password-value"><%= password || '-' %></span>
        </p>
      </div>

      <p>
        Please note that this password is temporary. For security reasons, kindly change it after your first login.
      </p>

      <p>Please use the link below to access the assessment portal:</p>

      <p>
        <strong>Access Portal:</strong><br />
        <a href="<%= loginLink %>" class="button-link">Login Here</a>
      </p>

      <div class="security-note">
        Do not share this password with anyone. This access is confidential and intended only for the authorized responder.
      </div>

      <p>Thank you for your cooperation.</p>

      <p>Best Regards,</p>
      <p><strong><%= leadReviewerName || userCompanyName || 'TPRM Team' %></strong></p>

      <% if (leadReviewerTitle) { %>
        <p><%= leadReviewerTitle %></p>
      <% } %>

      <% if (leadReviewerEmail || leadReviewerContactNumber) { %>
        <p>
          <% if (leadReviewerEmail) { %>
            Email: <%= leadReviewerEmail %>
          <% } %>

          <% if (leadReviewerEmail && leadReviewerContactNumber) { %>
            |
          <% } %>

          <% if (leadReviewerContactNumber) { %>
            Contact: <%= leadReviewerContactNumber %>
          <% } %>
        </p>
      <% } %>
    </div>

    <!-- Footer Section -->
    <div class="email-footer">
      <div class="green-line"></div>

      <div class="footer-content">
        <% if (companyLogoUrl) { %>
          <div class="company-logo">
            <img src="<%= companyLogoUrl %>" alt="Company Logo" />
          </div>
        <% } %>

        <div class="details">
          <h2><%= userCompanyName || 'TPRM Team' %></h2>

          <% if (userCompanyAddress) { %>
            <p><%= userCompanyAddress %></p>
          <% } %>

          <% if (userEmail) { %>
            <p>Email: <a href="mailto:<%= userEmail %>"><%= userEmail %></a></p>
          <% } %>

          <% if (userContactNumber) { %>
            <p>Contact: <%= userContactNumber %></p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="confidential-text">
      This is a confidential system-generated email.
    </div>

  </div>
</body>
</html>
