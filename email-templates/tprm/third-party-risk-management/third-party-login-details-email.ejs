<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Third Party Assessment Login Details</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f7fa;
      margin: 0;
      padding: 0;
      color: #333333;
      line-height: 1.6;
    }

    .email-container {
      max-width: 600px;
      margin: 30px auto;
      background-color: #ffffff;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
      overflow: hidden;
    }

    .email-body {
      padding: 20px 30px;
    }

    .email-body p {
      margin: 15px 0;
      font-size: 14px;
      color: #555555;
    }

    .email-body strong {
      color: #222222;
    }

    .highlight {
      background-color: #f1f9ff;
      padding: 10px;
      border-left: 4px solid #0073e6;
      margin-bottom: 20px;
      font-size: 14px;
      border-radius: 4px;
    }

    .inline-highlight {
      background-color: #f5f5f5;
      padding: 5px 8px;
      border-radius: 4px;
      color: #222222;
      display: inline-block;
    }

    .button-link {
      display: inline-block;
      padding: 10px 15px;
      background-color: #0073e6;
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 5px;
      font-size: 14px;
      margin: 15px 0;
    }

    .button-link:hover {
      background-color: #005bb5;
    }

    .email-footer {
      display: flex;
      align-items: center;
      padding: 20px;
      background-color: #f9f9f9;
    }

    .green-line {
      width: 4px;
      background-color: #00b050;
      align-self: stretch;
      margin-right: 15px;
    }

    .footer-content {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .company-logo img {
      max-width: 75px;
      height: auto;
      margin-right: 15px;
    }

    .details h2 {
      margin: 0;
      font-size: 16px;
      color: #084179;
    }

    .details p {
      margin: 3px 0;
      font-size: 14px;
      color: #555555;
    }

    .details a {
      color: #0073e6;
      text-decoration: none;
    }

    .details a:hover {
      text-decoration: underline;
    }

    .confidential-text {
      padding: 12px 20px 18px;
      background-color: #f9f9f9;
      text-align: center;
      font-size: 12px;
      color: #777777;
    }

    @media only screen and (max-width: 640px) {
      .email-container {
        margin: 15px;
      }

      .email-body {
        padding: 20px;
      }

      .email-footer {
        align-items: flex-start;
      }

      .footer-content {
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>
  <div class="email-container">

    <!-- Body Section -->
    <div class="email-body">
      <p>Dear <strong><%= leadResponderName || 'Third Party Responder' %></strong>,</p>

      <p><strong>Subject:</strong> Third Party Assessment Request Login Details</p>

      <p>
        Your third-party assessment portal access has been created for
        <strong><%= thirdPartyName || '-' %></strong>.
      </p>

      <p>
        We are providing access to our portal to complete the assigned questionnaire. Please see the login details below:
      </p>

      <div class="highlight">
        <p>
          <strong>Login ID:</strong>
          <span class="inline-highlight"><%= loginId || '-' %></span>
        </p>

        <p>
          <strong>Assessment ID:</strong>
          <span class="inline-highlight"><%= assessmentId || '-' %></span>
        </p>
      </div>

      <p>
        Your password will be sent in a separate email for security reasons.
      </p>

      <p>
        Please use the link below to access the questionnaire:
      </p>

      <p><strong>Access Portal:</strong></p>

      <a href="<%= loginLink %>" class="button-link">Login Here</a>

      <p>
        Once logged in, please complete the assigned questionnaire and submit your responses before the due date.
      </p>

      <p>Thank you for your cooperation.</p>

      <p>Best Regards,</p>

      <p><strong><%= leadReviewerName || userCompanyName || 'TPRM Team' %></strong></p>

      <% if (leadReviewerTitle) { %>
        <p><%= leadReviewerTitle %></p>
      <% } %>

      <% if (leadReviewerEmail || leadReviewerContactNumber) { %>
        <p>
          <% if (leadReviewerEmail) { %>
            Email: <%= leadReviewerEmail %>
          <% } %>

          <% if (leadReviewerEmail && leadReviewerContactNumber) { %>
            |
          <% } %>

          <% if (leadReviewerContactNumber) { %>
            Contact: <%= leadReviewerContactNumber %>
          <% } %>
        </p>
      <% } %>
    </div>

    <!-- Footer Section -->
    <div class="email-footer">
      <div class="green-line"></div>

      <div class="footer-content">
        <% if (companyLogoUrl) { %>
          <div class="company-logo">
            <img src="<%= companyLogoUrl %>" alt="Company Logo" />
          </div>
        <% } %>

        <div class="details">
          <h2><%= userCompanyName || 'TPRM Team' %></h2>

          <% if (userCompanyAddress) { %>
            <p><%= userCompanyAddress %></p>
          <% } %>

          <% if (userEmail) { %>
            <p>Email: <a href="mailto:<%= userEmail %>"><%= userEmail %></a></p>
          <% } %>

          <% if (userContactNumber) { %>
            <p>Contact: <%= userContactNumber %></p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="confidential-text">
      This email contains login information for the third-party assessment portal.
    </div>

  </div>
</body>
</html>
