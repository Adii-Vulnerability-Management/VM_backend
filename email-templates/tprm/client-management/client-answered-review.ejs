<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Client Answered — Review Required</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>
<body style="margin:0;padding:0;background:#f6f7f9;font-family:Arial,Helvetica,sans-serif;">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background:#f6f7f9;padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" cellpadding="0" cellspacing="0" width="600" style="max-width:600px;background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e5e7eb;">
          <!-- Header with date -->
          <tr>
            <td style="padding:16px 24px;border-bottom:1px solid #e5e7eb;">
              <table width="100%">
                <tr>
                  <td align="left" style="color:#6b7280;font-size:12px;">
                    <%= date %>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Main body -->
          <tr>
            <td style="padding:24px;">
              <h1 style="margin:0 0 8px 0;font-size:18px;color:#111827;">Client response received — review required</h1>
              <p style="margin:0 0 16px 0;color:#374151;font-size:14px;line-height:1.6;">
                The client has answered a question and it now requires your review.
              </p>

              <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin:12px 0 16px 0;">
                <tr>
                  <td style="padding:8px 0;font-size:14px;color:#111827;"><strong>Client:</strong> <%= vendorCompanyName %></td>
                </tr>
                <tr>
                  <td style="padding:8px 0;font-size:14px;color:#111827;"><strong>Question ID:</strong> <%= questionId %></td>
                </tr>
                <tr>
                  <td style="padding:8px 0;font-size:14px;color:#111827;"><strong>Status:</strong> <%= newStatus %></td>
                </tr>
              </table>


              <% if (loginLink) { %>
                <p style="margin:16px 0 0 0;">
                  <a href="<%= loginLink %>"
                    style="display:inline-block;background:#1f86ff;color:#ffffff;text-decoration:none;padding:10px 16px;border-radius:6px;font-size:14px;">
                    Open Review Portal
                  </a>
                </p>
              <% } %>

              <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0;" />
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
