<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vendor Password Details</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7fa;
            margin: 0;
            padding: 0;
            color: #333;
            line-height: 1.6;
        }

        .email-container {
            max-width: 600px;
            margin: 30px auto;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
            overflow: hidden;
        }

        .email-body {
            padding: 20px 30px;
        }

        .email-body p {
            margin: 15px 0;
            font-size: 14px;
            color: #555;
        }

        .highlight {
            background-color: #f1f9ff;
            padding: 10px;
            border-left: 4px solid #0073e6;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .button-link {
            display: inline-block;
            padding: 10px 15px;
            background-color: #0073e6;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-size: 14px;
            margin: 15px 0;
        }

        .button-link:hover {
            background-color: #005bb5;
        }

        .email-footer {
            display: flex;
            align-items: center;
            padding: 20px;
            background-color: #f9f9f9;
        }

        .green-line {
            width: 4px;
            background-color: #00b050;
            height: auto;
            margin-right: 15px;
        }

        .footer-content {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .company-logo img {
            max-width: 75px;
            height: auto;
            margin-right: 15px;
        }

        .details h2 {
            margin: 0;
            font-size: 16px;
            color: #084179;
        }

        .details p {
            margin: 3px 0;
            font-size: 14px;
            color: #555;
        }

        .details a {
            color: #0073e6;
            text-decoration: none;
        }

        .details a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <div class="email-container">
        <!-- Body Section -->
        <div class="email-body">
            <p>Dear <strong><%= leadResponderName %></strong>,</p>
            <p><strong>Subject:</strong> Vendor Access</p>
            <p>We are providing access to our portal to complete the questionnaire. Please see the login details below:</p>

            <p><strong>Password:</strong> <span class="highlight"><%= password %></span></p>
            <p>Please note the password is one-time and kindly change it on the first login.</p>
            <p>Please use the link below to access the questionnaire:</p>

            <p><strong>Access Portal:</strong></p>
            <a href="<%= loginLink %>" class="button-link">Login Here</a>

            <p>Thank you for your cooperation.</p>
            <p>Best Regards,</p>
            <p><strong><%= leadReviewerName %></strong></p>
            <p><%= leadReviewerTitle %></p>
            <p>Email: <%= leadReviewerEmail %> | Contact: <%= leadReviewerContactNumber %></p>
        </div>

        <!-- Footer Section -->
        <div class="email-footer">
            <!-- Green Line -->
            <div class="green-line"></div>

            <!-- Footer Content -->
            <div class="footer-content">
                <!-- Logo Section -->
                <div class="company-logo">
                    <img src="<%= companyLogoUrl %>" alt="Company Logo">
                </div>

                <!-- Details Section -->
                <div class="details">
                    <h2><%= userCompanyName %></h2>
                    <p><%= userCompanyAddress %></p>
                    <p>Email: <a href="mailto:<%= userEmail %>"><%= userEmail %></a></p>
                    <p>Contact: <%= userContactNumber %></p>
                </div>
            </div>
        </div>
        
    </div>
</body>

</html>
