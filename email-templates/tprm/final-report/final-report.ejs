<!DOCTYPE html>
<html>
  <body style="margin:0; padding:0; font-family:Arial, sans-serif; background:#f7f7fb;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background:#f7f7fb; padding:24px;">
      <tr>
        <td align="center">
          <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff; border-radius:10px; padding:24px;">
            <tr>
              <td>
                <h2 style="color:#21145f; margin-top:0;">
                  Final Third Party Risk Report
                </h2>

                <p>Hello,</p>

                <p>
                  Please find attached the final third party risk assessment report for
                  <strong><%= thirdPartyName %></strong>.
                </p>

                <p>
                  Assessment Year:
                  <strong><%= scheduleYear %></strong>
                </p>

                <p>
                  Kindly review the attached PDF for assessment details, risk review,
                  approvals, and final recommendations.
                </p>

                <p style="margin-top:24px;">
                  Regards,<br />
                  Third Party Risk Management Team
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>