<!doctype html>
<html>
  <body style="font-family: Arial, sans-serif; color: #111827;">
    <p>Hello <%= recipientName || 'there' %>,</p>
    <p><%= version?.title || 'A consent notice version' %> requires your attention.</p>
    <% if (typeof reason !== 'undefined' && reason) { %>
      <p><strong>Reason:</strong> <%= reason %></p>
    <% } %>
    <p>
      <a href="<%= portalLink %>" style="display:inline-block;padding:10px 14px;background:#111827;color:#ffffff;text-decoration:none;border-radius:6px;">Open Consent Notice</a>
    </p>
    <p style="color:#6b7280;font-size:12px;">This notification was generated by Consent Notice Management.</p>
  </body>
</html>
