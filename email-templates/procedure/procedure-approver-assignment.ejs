<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Approver Assignment</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      font-family: "Helvetica Neue", Arial, sans-serif;
      color: #444;
    }
    .container {
      max-width: 600px;
      margin: 40px auto;
      background-color: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    }
    .header {
      background-color: #0052cc;
      padding: 20px;
      text-align: center;
      color: #ffffff;
    }
    .header img {
      max-height: 40px;
      margin-bottom: 8px;
    }
    .header h1 {
      margin: 0;
      font-size: 20px;
      font-weight: normal;
    }
    .content {
      padding: 24px;
      line-height: 1.6;
    }
    .content h2 {
      color: #0052cc;
      font-size: 18px;
      margin-top: 0;
    }
    .content p {
      margin: 16px 0;
    }
    .details {
      background-color: #f9fafb;
      border-left: 4px solid #0052cc;
      padding: 12px 16px;
      border-radius: 4px;
    }
    .details ul {
      margin: 0;
      padding: 0 0 0 20px;
    }
    .btn {
      display: inline-block;
      margin: 24px 0;
      padding: 12px 24px;
      background-color: #0052cc;
      color: #ffffff;
      text-decoration: none;
      border-radius: 4px;
      font-weight: bold;
    }
    .footer {
      background-color: #f4f6f8;
      text-align: center;
      padding: 16px;
      font-size: 12px;
      color: #888;
    }
    @media only screen and (max-width: 620px) {
      .container { margin: 20px 16px; }
      .content { padding: 16px; }
      .btn { width: 100%; text-align: center; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <!-- Optional: Your logo -->
      <!-- <img src="<%= logoUrl %>" alt="Company Logo"> -->
      <h1>Approver Assignment</h1>
    </div>
    <div class="content">
      <h2>Hello, <%= approverName %> 👋</h2>
      <p>
        You’ve been designated as the <strong>approver</strong> for a new procedure in the system.
        Please find the details below, then click the button to review and complete your approval.
      </p>

      <div class="details">
        <ul>
          <li><strong>Procedure:</strong> <%= procedureName %></li>
          <li><strong>Version:</strong>   <%= version %></li>
        </ul>
      </div>

      <p style="text-align: center;">
        <a href="<%= approveLink %>" class="btn">Review &amp; Approve</a>
      </p>
      <p>Thank you for keeping our processes smooth!</p>
    </div>
  </div>
</body>
</html>
