<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title><%= subject %></title>
    <style>
      /* Keep styles very email-friendly */
      body { margin:0; padding:0; background:#f0f2f5; font-family: Arial, Helvetica, sans-serif; }
      .container { max-width:600px; margin:40px auto; background:#ffffff; border:1px solid #e0e0e0; border-radius:8px; }
      .header { background:#0056b3; color:#ffffff; padding:20px; border-radius:8px 8px 0 0; text-align:center; }
      .content { padding:24px; color:#333; font-size:14px; line-height:1.6; }
      .footer { color:#777; font-size:12px; text-align:center; padding:16px; border-top:1px solid #e0e0e0; }
      .preheader { display:none !important; visibility:hidden; opacity:0; height:0; width:0; overflow:hidden; mso-hide:all; }
      .details { margin-top:20px; border-top:1px solid #eee; padding-top:12px; }
      ul { padding-left:18px; }
      li { margin-bottom:6px; }
      a { color:#0056b3; }
    </style>
  </head>
  <body>
    <% if (preheader) { %>
      <div class="preheader"><%= preheader %></div>
    <% } %>

    <div class="container">
      <div class="header">
        <h1><%= subject %></h1>
      </div>

      <div class="content">
        <!-- <p>Hello <%= name || 'User' %>,</p> -->

        <% if (renderedBodyHtml) { %>
          <!-- Use the pre-rendered HTML exactly as-is -->
          <%- renderedBodyHtml %>
        <% } else if (renderedBodyText) { %>
          <pre style="white-space:pre-wrap;"><%= renderedBodyText %></pre>
        <% } else { %>
          <p>This is a notification.</p>
        <% } %>

        <% if (templateData && Object.keys(templateData).length) { %>
          <div class="details">
            <strong>Details</strong>
            <ul>
              <% Object.keys(templateData).forEach(function(key){ 
                   const value = templateData[key]; %>
                <li>
                  <strong><%= key %>:</strong>
                  <% if (Array.isArray(value)) { %>
                    <%= value.join(', ') %>
                  <% } else if (typeof value === 'object' && value !== null) { %>
                    <pre style="white-space:pre-wrap;"><%= JSON.stringify(value, null, 2) %></pre>
                  <% } else { %>
                    <%= String(value) %>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          </div>
        <% } %>
      </div>

      <div class="footer">
        <p>This is an automated message. Please do not reply.</p>
      </div>
    </div>
  </body>
</html>
