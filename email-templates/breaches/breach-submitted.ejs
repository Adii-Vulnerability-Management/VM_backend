<!DOCTYPE html>
<html>
  <body>
    <h2><%= breach?.title || 'Breach Notification' %></h2>

    <p>Hello,</p>

    <p>
      <%= message || 'There is an update on a breach.' %>
    </p>

    <% if (actor) { %>
      <p>
        Action by:
        <strong><%= actor.first_name || actor.name || actor.email || 'User' %></strong>
      </p>
    <% } %>

    <% if (portalLink) { %>
      <p>
        <a href="<%= portalLink %>">View Breach</a>
      </p>
    <% } %>

    <p>Thank you.</p>
  </body>
</html>