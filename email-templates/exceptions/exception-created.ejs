<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Exception Created</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f8;padding:24px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:10px;overflow:hidden;border:1px solid #e5e7eb;">
          <tr>
            <td style="padding:24px 28px;background:#2563eb;color:#ffffff;">
              <h1 style="margin:0;font-size:22px;font-weight:700;">Exception Created</h1>
            </td>
          </tr>

          <tr>
            <td style="padding:28px;">
              <p style="margin:0 0 16px;font-size:15px;line-height:1.6;">Hello,</p>

              <p style="margin:0 0 18px;font-size:15px;line-height:1.6;">
                A new exception has been created and assigned to you for visibility.
              </p>

              <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:18px 0;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden;">
                <tr>
                  <td style="padding:10px 12px;background:#f9fafb;font-weight:700;width:160px;">Title</td>
                  <td style="padding:10px 12px;"><%= exception?.title || 'New exception' %></td>
                </tr>
                <tr>
                  <td style="padding:10px 12px;background:#f9fafb;font-weight:700;">Status</td>
                  <td style="padding:10px 12px;"><%= exception?.status || 'Created' %></td>
                </tr>
                <% if (exception?.priority || exception?.severity || exception?.risk_level) { %>
                <tr>
                  <td style="padding:10px 12px;background:#f9fafb;font-weight:700;">Priority / Risk</td>
                  <td style="padding:10px 12px;"><%= exception?.priority || exception?.severity || exception?.risk_level %></td>
                </tr>
                <% } %>
                <% if (actor) { %>
                <tr>
                  <td style="padding:10px 12px;background:#f9fafb;font-weight:700;">Created By</td>
                  <td style="padding:10px 12px;"><%= actor?.first_name || actor?.name || actor?.email || 'User' %></td>
                </tr>
                <% } %>
                <% if (exception?.createdAt) { %>
                <tr>
                  <td style="padding:10px 12px;background:#f9fafb;font-weight:700;">Created On</td>
                  <td style="padding:10px 12px;"><%= new Date(exception.createdAt).toLocaleString() %></td>
                </tr>
                <% } %>
              </table>

              <% if (exception?.description) { %>
              <p style="margin:18px 0 8px;font-size:15px;font-weight:700;">Description</p>
              <p style="margin:0 0 18px;font-size:15px;line-height:1.6;color:#374151;"><%= exception.description %></p>
              <% } %>

              <p style="margin:24px 0;">
                <a href="<%= portalLink %>" style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;padding:12px 18px;border-radius:6px;font-size:14px;font-weight:700;">View Exception</a>
              </p>

              <p style="margin:0;font-size:13px;line-height:1.5;color:#6b7280;">
                This is an automated notification. Please do not reply to this email.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
