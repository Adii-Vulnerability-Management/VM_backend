<!doctype html>
<html>
  <body style="margin:0;padding:0;background:#f8fafc;font-family:Arial,sans-serif;color:#0f172a;">
    <div style="max-width:640px;margin:0 auto;padding:32px 20px;">
      <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:28px;">
        <h1 style="margin:0 0 12px;font-size:22px;color:#2B245C;">
          Exception approval assigned
        </h1>
        <p style="margin:0 0 18px;line-height:1.6;color:#475569;">
          An exception is awaiting your approval at level
          <strong><%= approvalLevel || 1 %></strong>.
        </p>

        <table style="width:100%;border-collapse:collapse;margin:18px 0;">
          <tr>
            <td style="padding:8px 0;color:#64748b;width:150px;">Exception</td>
            <td style="padding:8px 0;font-weight:600;">
              <%= exception?.exception_code || exception?._id || '-' %>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 0;color:#64748b;">Title</td>
            <td style="padding:8px 0;font-weight:600;">
              <%= exception?.title || 'Exception review' %>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 0;color:#64748b;">Risk level</td>
            <td style="padding:8px 0;font-weight:600;">
              <%= exception?.risk_level || '-' %>
            </td>
          </tr>
        </table>

        <a
          href="<%= portalLink %>"
          style="display:inline-block;background:#2B245C;color:#ffffff;text-decoration:none;padding:11px 18px;border-radius:8px;font-weight:600;"
        >
          Review exception
        </a>
      </div>
    </div>
  </body>
</html>
