<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Approver Assignment Notification</title>
  <style>
    body { font-family: Arial, sans-serif; color: #333; }
    .container { max-width: 600px; margin: 0 auto; }
    .header { background: #004080; color: white; padding: 20px; text-align: center; }
    .content { padding: 20px; }
    .button {
      display: inline-block;
      padding: 12px 24px;
      margin: 20px 0;
      background-color: #0066cc;
      color: white;
      text-decoration: none;
      border-radius: 4px;
    }
    .footer { font-size: 12px; color: #777; text-align: center; padding: 20px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>You’ve Been Assigned as Approver</h1>
    </div>
    <div class="content">
      <p>Hi <strong><%= approverName %></strong>,</p>
      <p>
        You have been assigned to approve the following policy:
      </p>
      <ul>
        <li><strong>Policy Name:</strong> <%= policyName %></li>
        <li><strong>Version:</strong> <%= version %></li>
      </ul>
      <p>
        Please click the button below to go to the approval page and complete your review:
      </p>
      <p style="text-align: center;">
        <a href="<%= approveLink %>" class="button">Approve Policy</a>
      </p>
      <p>Thank you for your prompt attention!</p>
    </div>
  </div>
</body>
</html>
