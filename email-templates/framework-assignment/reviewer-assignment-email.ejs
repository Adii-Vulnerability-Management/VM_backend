<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Framework Review Assignment</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f7fa;
        margin: 0;
        padding: 0;
        color: #333;
        line-height: 1.6;
      }

      .email-container {
        max-width: 600px;
        margin: 30px auto;
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        border: 1px solid #ddd;
      }

      .email-header {
        background-color: #084179;
        color: #ffffff;
        padding: 20px;
        text-align: center;
        font-size: 18px;
        font-weight: bold;
      }

      .email-body {
        padding: 20px 30px;
      }

      .email-body p {
        margin: 15px 0;
        font-size: 14px;
      }

      .details {
        margin: 20px 0;
        padding: 15px;
        background-color: #f9f9f9;
        border-left: 4px solid #084179;
        border-radius: 4px;
      }

      .details p {
        margin: 5px 0;
        font-size: 14px;
        font-weight: bold;
      }

      .details ul {
        margin: 10px 0;
        padding-left: 20px;
      }

      .details ul li {
        font-size: 14px;
        margin-bottom: 5px;
      }

      .button {
        display: inline-block;
        padding: 10px 20px;
        margin: 20px 0;
        color: #ffffff;
        background-color: #084179;
        text-decoration: none;
        border-radius: 4px;
        font-size: 14px;
        text-align: center;
      }

      .button:hover {
        background-color: #063358;
      }

      .email-footer {
        padding: 15px;
        text-align: center;
        font-size: 12px;
        color: #777;
        background-color: #f1f1f1;
        border-top: 1px solid #ddd;
      }
    </style>
  </head>

  <body>
    <div class="email-container">
      <div class="email-header">Framework Review Assignment</div>
      <div class="email-body">
        <p>Dear Reviewer,</p>
        <p>
          You have been assigned a framework review task. Below are the details of your assignment:
        </p>

        <div class="details">
          <h3>Assignment Details</h3>
          <p><strong>Framework Name:</strong> <%= frameworkname %></p>
          <p><strong>Description:</strong> <%= frameworkdescription %></p>
          <p><strong>Assign Date:</strong> <%= new Date(assignDate).toDateString() %></p>
          <p><strong>Deadline:</strong> <%= new Date(deadline).toDateString() %></p>
        </div>

        <div class="details">
          <h3>Categories</h3>
          <ul>
            <% categories.forEach(category => { %>
              <li><%= category %></li>
            <% }); %>
          </ul>
        </div>

        <div class="details">
          <h3>Controls Assigned</h3>
          <ul>
            <% controls.forEach(control => { %>
              <li><%= control %></li>
            <% }); %>
          </ul>
        </div>

        <p>
          Please review the assigned framework and ensure compliance before the deadline.
        </p>

        <a href="<%= reviewUrl %>" class="button">Review Assignment</a>

        <p>
          If you have any questions or need assistance, feel free to reach out.
        </p>

        <p>Best Regards,</p>
        <p><strong>Compliance Team</strong></p>
      </div>

      <div class="email-footer">
        This is an automated email. Please do not reply.<br />
      </div>
    </div>
  </body>
</html>
