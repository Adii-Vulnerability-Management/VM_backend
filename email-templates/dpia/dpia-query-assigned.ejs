<%
  const safe = (value, fallback = '-') => {
    if (value === undefined || value === null || value === '') return fallback;
    if (Array.isArray(value)) return value.map((v) => safe(v, '')).filter(Boolean).join(', ') || fallback;
    if (typeof value === 'object') {
      if (value.name || value.title || value.label || value.email) return value.name || value.title || value.label || value.email;
      try { return JSON.stringify(value); } catch (e) { return fallback; }
    }
    return String(value);
  };

  const _title = safe(typeof title !== 'undefined' ? title : undefined, 'DPIA Query Assigned');
  const _message = safe(typeof message !== 'undefined' ? message : undefined, 'A DPIA query has been assigned and requires a response.');
  const _recipientName = safe(typeof recipientName !== 'undefined' ? recipientName : (typeof name !== 'undefined' ? name : undefined), 'User');
  const _businessProcess = safe(typeof businessProcess !== 'undefined' ? businessProcess : (typeof businessProcessName !== 'undefined' ? businessProcessName : undefined));
  const _companyName = safe(typeof companyName !== 'undefined' ? companyName : (typeof company !== 'undefined' ? company : undefined));
  const _templateName = safe(typeof templateName !== 'undefined' ? templateName : undefined);
  const _version = safe(typeof templateVersion !== 'undefined' ? templateVersion : (typeof version !== 'undefined' ? version : undefined));
  const _status = safe(typeof status !== 'undefined' ? status : (typeof currentStatus !== 'undefined' ? currentStatus : undefined));
  const _stageName = safe(typeof stageName !== 'undefined' ? stageName : (typeof currentStage !== 'undefined' ? currentStage : undefined));
  const _assignee = safe(typeof assigneeName !== 'undefined' ? assigneeName : (typeof reviewerName !== 'undefined' ? reviewerName : undefined));
  const _approver = safe(typeof approverName !== 'undefined' ? approverName : undefined);
  const _dueDate = safe(typeof dueDate !== 'undefined' ? dueDate : (typeof currentDueDate !== 'undefined' ? currentDueDate : (typeof reviewDueDate !== 'undefined' ? reviewDueDate : undefined)));
  const _sla = safe(typeof slaDays !== 'undefined' ? slaDays : undefined);
  const _escalationOwner = safe(typeof escalationOwnerName !== 'undefined' ? escalationOwnerName : (typeof escalationOwner !== 'undefined' ? escalationOwner : undefined));
  const _queryTitle = safe(typeof queryTitle !== 'undefined' ? queryTitle : (typeof titleOfQuery !== 'undefined' ? titleOfQuery : undefined));
  const _priority = safe(typeof priority !== 'undefined' ? priority : undefined);
  const _comment = safe(typeof comment !== 'undefined' ? comment : (typeof note !== 'undefined' ? note : (typeof submissionNote !== 'undefined' ? submissionNote : undefined)));
  const _generatedAt = new Date().toLocaleString('en-IN');
  const _portalLink = safe(typeof portalLink !== 'undefined' ? portalLink : (typeof actionUrl !== 'undefined' ? actionUrl : (typeof link !== 'undefined' ? link : undefined)), '');
%>
<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>
<body style="margin:0;padding:0;background:#f4f6fb;font-family:Arial,Helvetica,sans-serif;color:#111827;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f6fb;margin:0;padding:28px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="680" cellspacing="0" cellpadding="0" style="width:680px;max-width:94%;background:#ffffff;border:1px solid #e5e7eb;border-radius:14px;overflow:hidden;">
          <tr>
            <td style="background:#2B245C;padding:26px 30px;color:#ffffff;">
              <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:#e9e7ff;">GRC³ DPIA Workspace</div>
              <div style="font-size:24px;line-height:1.25;font-weight:700;margin-top:8px;color:#ffffff;"><%= _title %></div>
              <div style="font-size:14px;line-height:1.5;margin-top:8px;color:#f3f4f6;"><%= _message %></div>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 30px 10px 30px;">
              <p style="font-size:15px;line-height:1.6;margin:0 0 14px 0;color:#111827;">Hello <strong><%= _recipientName %></strong>,</p>
              <p style="font-size:15px;line-height:1.6;margin:0 0 22px 0;color:#374151;"><%= _message %></p>

              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:separate;border-spacing:0;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;margin:0 0 22px 0;">
                <tr><td colspan="2" style="background:#f9fafb;padding:13px 16px;font-size:14px;font-weight:700;color:#111827;border-bottom:1px solid #e5e7eb;">DPIA Summary</td></tr>
                <tr><td style="width:38%;padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">Business Process</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _businessProcess %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">Company</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _companyName %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">Template</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _templateName %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">Version</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _version %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">Current Status</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _status %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">Current Stage</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _stageName %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">Assignee / Reviewer</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _assignee %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">Approver</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _approver %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">Due Date</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _dueDate %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">SLA Days</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _sla %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">Escalation Owner</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _escalationOwner %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">Query</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _queryTitle %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;border-bottom:1px solid #edf0f5;">Priority</td><td style="padding:11px 16px;font-size:13px;color:#111827;border-bottom:1px solid #edf0f5;"><%= _priority %></td></tr>
                <tr><td style="padding:11px 16px;font-size:13px;color:#6b7280;">Note</td><td style="padding:11px 16px;font-size:13px;color:#111827;"><%= _comment %></td></tr>
              </table>

              <% if (_portalLink) { %>
                <table role="presentation" cellspacing="0" cellpadding="0" style="margin:8px 0 24px 0;">
                  <tr><td style="background:#2B245C;border-radius:8px;"><a href="<%= _portalLink %>" style="display:inline-block;padding:12px 20px;color:#ffffff;text-decoration:none;font-size:14px;font-weight:700;">Open DPIA Workspace</a></td></tr>
                </table>
              <% } %>
            </td>
          </tr>
          <tr>
            <td style="background:#f9fafb;padding:16px 30px;border-top:1px solid #e5e7eb;color:#6b7280;font-size:12px;line-height:1.5;">
              Generated at: <%= _generatedAt %><br />
              This is an automated notification from GRC³ DPIA Workspace. Please do not reply to this email.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
