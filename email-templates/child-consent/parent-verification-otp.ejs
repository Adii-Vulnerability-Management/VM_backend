<!DOCTYPE html>
<html>
  <body style="font-family: Arial, sans-serif; color: #111827;">
    <% if (companyLogoUrl) { %>
      <div style="margin-bottom: 16px;">
        <img src="<%= companyLogoUrl %>" alt="Logo" style="max-height: 48px;" />
      </div>
    <% } %>

    <h2 style="margin-bottom: 12px;"><%= brandName %></h2>

    <p>Hello <%= parentGuardianName %>,</p>

    <p>
      A child consent request has been initiated for
      <strong><%= childName %></strong>.
    </p>

    <p>
      To verify parental or guardian consent, please use the verification code below:
    </p>

    <div
      style="
        font-size: 28px;
        font-weight: bold;
        letter-spacing: 4px;
        background: #f3f4f6;
        padding: 16px;
        display: inline-block;
        margin: 12px 0;
      "
    >
      <%= otp %>
    </div>

    <p>This code will expire in <strong><%= expiryMinutes %> minutes</strong>.</p>

    <p>Expires at: <%= expiresAt %></p>

    <hr style="margin: 24px 0;" />

    <p style="font-size: 12px; color: #6b7280;">
      Policy Version: <%= policyVersion %><br />
      Consent Version: <%= consentVersion %>
    </p>
  </body>
</html>