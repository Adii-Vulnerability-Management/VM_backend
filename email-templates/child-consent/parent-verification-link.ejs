<!DOCTYPE html>
<html>
  <body style="font-family: Arial, sans-serif; color: #111827;">
    <% if (companyLogoUrl) { %>
      <div style="margin-bottom: 16px;">
        <img src="<%= companyLogoUrl %>" alt="Logo" style="max-height: 48px;" />
      </div>
    <% } %>

    <h2 style="margin-bottom: 12px;"><%= brandName %></h2>

    <p>Hello <%= parentGuardianName %>,</p>

    <p>
      A child consent request has been initiated for
      <strong><%= childName %></strong>.
    </p>

    <p>
      To verify parental or guardian consent, please click the button below:
    </p>

    <p style="margin: 20px 0;">
      <a
        href="<%= verifyLink %>"
        style="
          background: #2563eb;
          color: white;
          text-decoration: none;
          padding: 12px 18px;
          border-radius: 8px;
          display: inline-block;
        "
      >
        Verify Parent Consent
      </a>
    </p>

    <p>This link expires at: <%= expiresAt %></p>

    <hr style="margin: 24px 0;" />

    <p style="font-size: 12px; color: #6b7280;">
      Policy Version: <%= policyVersion %><br />
      Consent Version: <%= consentVersion %>
    </p>
  </body>
</html>