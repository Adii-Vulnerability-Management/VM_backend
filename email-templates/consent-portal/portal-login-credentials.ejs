<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Your Consent Portal Login Credentials</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        color: #111827;
        line-height: 1.6;
        background-color: #f9fafb;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      }
      h1 {
        color: #1f2937;
        font-size: 22px;
        margin-bottom: 20px;
      }
      p {
        font-size: 16px;
        margin-bottom: 16px;
      }
      .credentials {
        background-color: #f3f4f6;
        border-left: 4px solid #3b82f6;
        padding: 15px;
        margin: 20px 0;
        border-radius: 4px;
      }
      .cta-button {
        display: inline-block;
        background-color: #3b82f6;
        color: #ffffff !important;
        text-decoration: none;
        font-weight: bold;
        padding: 12px 24px;
        border-radius: 6px;
        margin-top: 15px;
      }
      .footer {
        font-size: 14px;
        color: #6b7280;
        margin-top: 30px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Hello <%= name || 'User' %>,</h1>

      <p>Your Consent Portal account has been created successfully.</p>

      <div class="credentials">
        <p><strong>Login Email:</strong> <%= email %></p>
        <p><strong>Temporary Password:</strong> <%= temporaryPassword %></p>
        <a href="<%= portalLoginUri %>" class="cta-button">Login to Consent Portal</a>
      </div>

      <p>Please log in using the above temporary password and change it after your first login.</p>

      <p>If you did not request this access, please contact support<% if (supportEmail) { %> at <%= supportEmail %><% } %>.</p>

      <div class="footer">
        <p>Regards,<br/>Consent Portal Team</p>
      </div>
    </div>
  </body>
</html>