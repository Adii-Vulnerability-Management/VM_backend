
<style>
  body {
    font-family: Arial, sans-serif;
    line-height: 1.5;
    color: #333;
  }
  h2 {
    color: #004aad;
  }
  h3 {
    color: #0056b3;
    border-bottom: 1px solid #ddd;
    padding-bottom: 5px;
  }
  h4 {
    color: #333;
    margin-top: 20px;
  }
  p {
    margin: 5px 0;
  }
  ul {
    margin-top: 8px;
  }
  .section {
    margin-bottom: 25px;
  }
  .highlight {
    font-weight: bold;
    color: #000;
  }
  .consent-box {
    background-color: #f5f5f5;
    padding: 15px;
    border-left: 4px solid #004aad;
    margin-top: 10px;
  }
  .success {
    color: #0a7a28;
    font-weight: bold;
  }
  hr {
    border: 0;
    border-top: 1px solid #ddd;
    margin: 20px 0;
  }
</style>

<h2>Consent Recorded Successfully</h2>

<div class="section">
  <p>
    This email confirms that consent has been successfully
  </p>

  <p class="success">
    Consent Status: <%= consentStatus %>
  </p>
</div>

<hr />

<div class="section">
  <h3>Submitted User Details</h3>

  <p><span class="highlight">Name:</span> <%= fullName %></p>
  <p><span class="highlight">Email:</span> <%= email %></p>
  <p><span class="highlight">Domain:</span> <%= domainName %></p>
  <p><span class="highlight">Form Name:</span> <%= formName %></p>
  <p><span class="highlight">Consent Captured At:</span> <%= consentCapturedAt %></p>
</div>

<hr />

<div class="section">
  <h3>Consent Details</h3>

  <div class="consent-box">
    <p>
      The user has provided free, specific, informed, unconditional, and unambiguous
      consent for the processing of their personal data in accordance with the
      <strong>Digital Personal Data Protection Act, 2023 (“DPDPA”)</strong>.
    </p>

    <h4>Consent Source</h4>
    <p>
      Consent was captured from the API endpoint:
      <strong><%= apiSource %></strong>
    </p>

    <h4>Consent Acceptance</h4>
    <p>
      <span class="highlight">Consent Accepted:</span> <%= consentAccepted %>
    </p>
    <p>
      <span class="highlight">Consent Version:</span> <%= consentVersion %>
    </p>
    <p>
      <span class="highlight">Policy Version:</span> <%= policyVersion %>
    </p>
    <p>
      <span class="highlight">Consent Text Version:</span> <%= consentTextVersion %>
    </p>

    <h4>Purpose of Processing</h4>
    <ul>
      <li>To record and manage the user’s consent preferences.</li>
      <li>To maintain an auditable consent record.</li>
      <li>To provide access to the consent/data-principal portal.</li>
      <li>To comply with applicable privacy and data protection requirements.</li>
    </ul>

    <h4>Consent Declaration</h4>
    <p>
      I, <strong><%= fullName %></strong>, using the email address
      <strong><%= email %></strong>, confirm that I have read and understood the
      consent notice and agree to the processing of my personal data for the
      purposes mentioned above.
    </p>
  </div>
</div>

<p>
  Regards,<br />
  <strong><%= organisationName %></strong>
</p>
