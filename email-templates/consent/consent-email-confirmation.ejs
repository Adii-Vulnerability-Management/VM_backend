<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Confirm your consent</title>
  </head>
  <body style="margin:0;background:#f5f7fb;font-family:Arial,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f5f7fb;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:620px;background:#ffffff;border-radius:12px;border:1px solid #e5e7eb;">
            <tr>
              <td style="padding:32px;">
                <h1 style="margin:0 0 16px;font-size:24px;color:#2b245c;">Confirm your consent</h1>

                <p style="margin:0 0 16px;line-height:1.6;">
                  Hello <%= fullName %>, your on-site consent request has been received. Please complete the second confirmation step using the button below.
                </p>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:20px 0;background:#f8fafc;border:1px solid #e5e7eb;border-radius:8px;">
                  <tr>
                    <td style="padding:16px;line-height:1.7;">
                      <strong>Consent request:</strong> <%= formName %><br />
                      <strong>Reference ID:</strong> <%= submissionId %><br />
                      <strong>Summary:</strong> <%= consentSummary %><br />
                      <strong>Confirmation deadline:</strong> <%= confirmationDeadline %>
                    </td>
                  </tr>
                </table>

                <table role="presentation" cellspacing="0" cellpadding="0" style="margin:24px auto;">
                  <tr>
                    <td style="background:#2b245c;border-radius:8px;">
                      <a href="<%= confirmationUrl %>" style="display:inline-block;padding:14px 24px;color:#ffffff;text-decoration:none;font-weight:700;">Confirm Consent</a>
                    </td>
                  </tr>
                </table>

                <p style="margin:0 0 16px;line-height:1.6;color:#4b5563;">
                  This link is single-use. If it is not used before the deadline, the request will expire without becoming active consent.
                </p>

                <% if (portalLoginUri) { %>
                  <p style="margin:0 0 16px;line-height:1.6;">
                    You can view the request in the <a href="<%= portalLoginUri %>" style="color:#2b245c;font-weight:700;">Consent Portal</a>.
                  </p>
                <% } %>

                <p style="margin:24px 0 0;font-size:12px;line-height:1.5;color:#6b7280;">
                  If you did not submit this request, do not use the confirmation link.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
